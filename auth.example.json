{
  "apiKey": "your_api_key_here",
  "apiSecret": "your_api_secret_here",
  "auth": {
    "type": "Bearer",
    "headerName": "Authorization",
    "tokenPrefix": "Bearer "
  },
  "endpoints": {
    "baseUrl": "https://api.form-create.com",
    "login": "/api/v1/auth/login",
    "refresh": "/api/v1/auth/refresh",
    "logout": "/api/v1/auth/logout"
  },
  "config": {
    "timeout": 30000,
    "retries": 3,
    "retryDelay": 1000
  }
}
